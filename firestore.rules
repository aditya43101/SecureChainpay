rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usernames collection:
    // - Anyone can read/check availability
    // - Authenticated users can create an unclaimed username for their own UID
    // - Only the owner can modify their username record
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    
    // Users collection:
    // - Users can read their own profile document
    // - Users can update non-sensitive profile fields (displayName, photoURL, preferences, phoneNumber)
    // - Users CANNOT directly modify their role, isAdmin, permissions, balances, or trusted security flags
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && !('role' in request.resource.data)
                    && !('isAdmin' in request.resource.data)
                    && !('balances' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'permissions', 'balances', 'verified']);
      allow delete: if false;
      
      // Sensitive User Subcollections:
      
      // 1. WALLET DATA:
      // - Client may READ their own wallet
      // - Client CANNOT WRITE / UPDATE directly. All wallet provisioning, key lifecycle, and balance
      //   transitions MUST pass through authenticated server routes via Firebase Admin SDK.
      match /wallet/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      
      // 2. USER TRANSACTIONS:
      // - Client may READ their own transaction history
      // - Client CANNOT WRITE / INJECT transactions directly. All transaction records and confirmations
      //   must be authored atomically by the server.
      match /transactions/{txId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // 3. PAYMENT REQUESTS:
      // - User can create payment requests for themselves
      match /paymentRequests/{reqId} {
        allow read: if request.auth != null && (request.auth.uid == userId || resource.data.recipientUid == request.auth.uid);
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && (request.auth.uid == userId || resource.data.recipientUid == request.auth.uid);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Catch-all for any other user subcollections: default to read-only for owner, no direct client writes
      match /{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // ─── TRUSTED LEDGER COLLECTIONS (ZERO DIRECT CLIENT WRITES) ───

    // Global Blockchain — public read for explorer, ZERO direct client writes.
    // Only the trusted server-side BlockchainWriteService (Admin SDK) can append blocks.
    match /global_blocks/{blockId} {
      allow read: if true;
      allow write: if false;
    }

    // Global Chain Meta — public read for chain height/hash, ZERO direct client writes.
    match /global_chain_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Security Audit Events — SERVER ONLY. No client read, no client write.
    match /securityEvents/{eventId} {
      allow read, write: if false;
    }

    // Default deny for any unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
