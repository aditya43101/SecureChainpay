generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MERCHANT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
}

model User {
  id              String   @id @default(uuid())
  email           String?  @unique
  phone           String?  @unique
  passwordHash    String?
  firstName       String?
  lastName        String?
  role            Role     @default(USER)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallets                 Wallet[]
  sessions                Session[]
  devices                 Device[]
  loginHistory            LoginHistory[]
  notifications           Notification[]
  kycDocument             KycDocument?
  linkedAccounts          LinkedAccount[]
  merchant                Merchant?
  sentTransactions        Transaction[]      @relation("Sender")
  receivedTransactions    Transaction[]      @relation("Receiver")
  paymentRequestsSent     PaymentRequest[]   @relation("Requestor")
  paymentRequestsReceived PaymentRequest[]   @relation("Requestee")
  chatMessagesSent        ChatMessage[]      @relation("MessageSender")
  chatMessagesReceived    ChatMessage[]      @relation("MessageReceiver")
  auditLogs               AuditLog[]
  scheduledPayments       ScheduledPayment[]
  spendingGoals           SpendingGoal[]
  favouriteContacts       FavouriteContact[] @relation("UserContacts")
  favouritedBy            FavouriteContact[] @relation("ContactedUser")
  reports                 Report[]
  aiConversations         AIConversation[]
  tradingRecommendations  TradingRecommendation[]
  userRiskSettings        UserRiskSettings?
  backtestRuns            BacktestRun[]
  paperAccount            PaperAccount?
  tradingJournalEntries   TradingJournalEntry[]
  tradeAttributions       TradeAttribution[]
  feedbackMemories        FeedbackMemory[]
  learningEvents          LearningEvent[]
  autoTradingSettings     AutoTradingSettings?
  executionOrders         ExecutionOrder[]
  safetyEvents            SafetyEvent[]
  paymentIntents          PaymentIntent[]
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  address   String   @unique
  balance   Decimal  @default(0.0)
  currency  String   @default("USD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id           String            @id @default(uuid())
  txHash       String?           @unique
  senderId     String?
  sender       User?             @relation("Sender", fields: [senderId], references: [id])
  receiverId   String?
  receiver     User?             @relation("Receiver", fields: [receiverId], references: [id])
  amount       Decimal
  currency     String            @default("USD")
  status       TransactionStatus @default(PENDING)
  type         TransactionType
  description  String?
  fee          Decimal           @default(0.0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  settlement   Settlement?       @relation(fields: [settlementId], references: [id])
  settlementId String?
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Device {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  deviceId   String   @unique
  deviceName String?
  isTrusted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  status    String // SUCCESS, FAILED
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String // INFO, ALERT, TRANSACTION
  createdAt DateTime @default(now())
}

model PaymentRequest {
  id          String   @id @default(uuid())
  requestorId String
  requestor   User     @relation("Requestor", fields: [requestorId], references: [id])
  requesteeId String
  requestee   User     @relation("Requestee", fields: [requesteeId], references: [id])
  amount      Decimal
  currency    String   @default("USD")
  status      String // PENDING, PAID, CANCELLED
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KycDocument {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  documentType String // ID_CARD, PASSPORT, DRIVERS_LICENSE
  documentUrl  String
  status       String // PENDING, APPROVED, REJECTED
  uploadedAt   DateTime  @default(now())
  verifiedAt   DateTime?
}

model LinkedAccount {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  provider    String // STRIPE, PAYPAL, BANK
  accountId   String
  accountName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Merchant {
  id           String       @id @default(uuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id])
  businessName String
  apiKey       String       @unique
  webhookUrl   String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  settlements  Settlement[]
}

model Settlement {
  id           String        @id @default(uuid())
  merchantId   String
  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  amount       Decimal
  currency     String        @default("USD")
  status       String // PENDING, COMPLETED, FAILED
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model ScheduledPayment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  recipientId String
  amount      Decimal
  currency    String   @default("USD")
  frequency   String // DAILY, WEEKLY, MONTHLY
  nextRunAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SpendingGoal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  category      String
  targetAmount  Decimal
  currentAmount Decimal  @default(0.0)
  currency      String   @default("USD")
  month         Int
  year          Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FavouriteContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserContacts", fields: [userId], references: [id])
  contactId String
  contact   User     @relation("ContactedUser", fields: [contactId], references: [id])
  nickname  String?
  createdAt DateTime @default(now())

  @@unique([userId, contactId])
}

model Report {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  reportType String // TRANSACTION_HISTORY, TAX_REPORT
  fileUrl    String?
  status     String // PENDING, COMPLETED, FAILED
  createdAt  DateTime @default(now())
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  title     String?
  asset     String?
  mode      String
  messages  AIMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // USER, ASSISTANT, SYSTEM
  content        String         @db.Text
  createdAt      DateTime       @default(now())
}

model ModelPrediction {
  id                 String   @id @default(uuid())
  modelVersion       String
  symbol             String
  timeframe          String
  bullishProbability Float
  bearishProbability Float
  dataTimestamp      DateTime
  createdAt          DateTime @default(now())
  futureOutcome      Boolean?
}

model MarketCandle {
  id        String   @id @default(uuid())
  symbol    String // e.g., BTCUSDT
  timeframe String // e.g., 1h, 1d
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp(sort: Desc)])
}

model TradingRecommendation {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  symbol         String
  timeframe      String
  action         String   // BUY, SELL, HOLD, NO_TRADE
  strength       String   // LOW, MEDIUM, HIGH
  strategy       String   // HYBRID, EMA_TREND, RSI_MOMENTUM, MACD_MOMENTUM, BREAKOUT
  entry          Json     // { type: "ZONE" | "EXACT", low: number, high: number }
  stopLoss       Float
  takeProfit     Float
  riskReward     Float
  positionSize   Float?
  score          Float
  modelVersion   String?
  mlPrediction   Json?
  riskAssessment Json?
  reasons        String[]
  warnings       String[]
  outcome        String   @default("PENDING") // PENDING, WIN, LOSS, EXPIRED
  dataTimestamp  DateTime
  createdAt      DateTime @default(now())

  @@index([symbol, createdAt(sort: Desc)])
}

model UserRiskSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  accountCapital       Float    @default(100000.0)
  maxRiskPerTrade      Float    @default(0.01)    // 1%
  maxDailyLoss         Float    @default(0.03)    // 3%
  maxPortfolioExposure Float    @default(0.20)    // 20%
  maxAssetExposure     Float    @default(0.10)    // 10%
  minRiskReward        Float    @default(1.5)     // 1:1.5
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model BacktestRun {
  id             String          @id @default(uuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  symbol         String
  timeframe      String
  strategy       String          // HYBRID, EMA_TREND, RSI, MACD, BREAKOUT
  startDate      DateTime
  endDate        DateTime
  initialCapital Float
  finalCapital   Float
  totalReturn    Float           // Percentage
  benchmarkReturn Float          // Buy & Hold return %
  maxDrawdown    Float           // Percentage
  winRate        Float           // Percentage
  profitFactor   Float
  sharpeRatio    Float
  sortinoRatio   Float
  totalTrades    Int
  winningTrades  Int
  losingTrades   Int
  totalFees      Float
  totalSlippage  Float
  modelVersion   String?
  configJson     Json
  equityCurve    Json            // Array of { timestamp, equity, drawdown }
  createdAt      DateTime        @default(now())
  trades         BacktestTrade[]
}

model BacktestTrade {
  id               String      @id @default(uuid())
  backtestId       String
  backtest         BacktestRun @relation(fields: [backtestId], references: [id], onDelete: Cascade)
  symbol           String
  side             String      // LONG, SHORT
  entryTime        DateTime
  entryPrice       Float
  exitTime         DateTime
  exitPrice        Float
  quantity         Float
  stopLoss         Float
  takeProfit       Float
  fees             Float
  slippage         Float
  grossPnL         Float
  netPnL           Float
  returnPercentage Float
  exitReason       String      // STOP_LOSS, TAKE_PROFIT, SIGNAL_EXIT, END_OF_BACKTEST
  marketRegime     String?
}

model PaperAccount {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id])
  initialBalance Float           @default(100000.0)
  cashBalance    Float           @default(100000.0)
  equity         Float           @default(100000.0)
  realizedPnL    Float           @default(0.0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  positions      PaperPosition[]
  orders         PaperOrder[]
}

model PaperPosition {
  id             String       @id @default(uuid())
  accountId      String
  account        PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol         String
  side           String       // LONG, SHORT
  quantity       Float
  averageEntry   Float
  currentPrice   Float
  stopLoss       Float
  takeProfit     Float
  unrealizedPnL  Float
  openedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PaperOrder {
  id           String       @id @default(uuid())
  accountId    String
  account      PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol       String
  side         String       // BUY, SELL
  type         String       // MARKET, LIMIT
  quantity     Float
  price        Float
  stopLoss     Float?
  takeProfit   Float?
  fees         Float        @default(0.0)
  status       String       // FILLED, CANCELLED, PENDING
  executedAt   DateTime     @default(now())
}

model TradingJournalEntry {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  symbol         String
  strategy       String
  side           String   // LONG, SHORT
  entryPrice     Float
  exitPrice      Float
  pnl            Float
  pnlPercentage  Float
  exitReason     String   // STOP_LOSS, TAKE_PROFIT, MANUAL
  lossCategory   String?  // TREND_REVERSAL, FALSE_BREAKOUT, WEAK_MOMENTUM, VOLATILITY_SPIKE
  marketRegime   String?
  createdAt      DateTime @default(now())
}

model TradeAttribution {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  symbol         String
  timeframe      String
  strategy       String
  side           String   // LONG, SHORT
  entryPrice     Float
  exitPrice      Float
  stopLoss       Float
  takeProfit     Float
  mae            Float    // Maximum Adverse Excursion %
  mfe            Float    // Maximum Favorable Excursion %
  netPnL         Float
  returnPercent  Float
  outcome        String   // WIN, LOSS, BREAKEVEN
  primaryReason  String   // WRONG_DIRECTION, FALSE_BREAKOUT, TREND_REVERSAL, HIGH_VOLATILITY, etc.
  indicators     Json     // { rsi, macd, ema20, ema50, atr, volatility }
  mlPrediction   Json?    // { bullishProbability, bearishProbability, marketRegime }
  createdAt      DateTime @default(now())
}

model FeedbackMemory {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  symbol         String
  timeframe      String
  strategy       String
  marketRegime   String?
  pattern        String   // e.g. "HIGH_VOLATILITY_FALSE_BREAKOUT"
  type           String   // FAILURE_PATTERN, SUCCESS_PATTERN
  observation    String
  evidenceCount  Int
  winRate        Float
  profitFactor   Float
  confidence     Float    // Statistical confidence score
  status         String   @default("VALIDATED") // CANDIDATE, VALIDATED, REJECTED, EXPIRED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StrategyVersion {
  id             String   @id @default(uuid())
  versionName    String   @unique // e.g. "HYBRID_v1", "HYBRID_v2"
  strategyType   String   // HYBRID, EMA_TREND, RSI, MACD, BREAKOUT
  parameters     Json     // { config, filters }
  isChampion     Boolean  @default(false)
  isChallenger   Boolean  @default(false)
  totalReturn    Float    @default(0.0)
  maxDrawdown    Float    @default(0.0)
  winRate        Float    @default(0.0)
  profitFactor   Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LearningEvent {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  eventType      String   // PATTERN_DISCOVERED, CANDIDATE_BACKTESTED, CHAMPION_PROMOTED, PATTERN_EXPIRED
  title          String
  description    String
  metadata       Json?
  createdAt      DateTime @default(now())
}

model AutoTradingSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  enabled              Boolean  @default(false)
  mode                 String   @default("PAPER") // MANUAL, PAPER, AUTO
  allowedAssets        String[] @default(["BTCUSDT", "ETHUSDT"])
  allowedTimeframes    String[] @default(["1h", "4h", "1d"])
  strategyVersion      String   @default("HYBRID_v1")
  modelVersion         String   @default("LOG_v1")
  riskPerTrade         Float    @default(0.01) // 1%
  maxDailyLoss         Float    @default(0.03) // 3%
  maxOpenPositions     Int      @default(3)
  maxPortfolioExposure Float    @default(0.20) // 20%
  maxAssetExposure     Float    @default(0.10) // 10%
  minRiskReward        Float    @default(1.5)
  maxSlippage          Float    @default(0.005) // 0.5%
  cooldownPeriod       Int      @default(300) // seconds (5 min)
  allTimeMode          Boolean  @default(false)
  status               String   @default("DISABLED") // DISABLED, ENABLED, PAUSED, EMERGENCY_STOP, ERROR
  pausedReason         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model TradeApproval {
  id               String   @id @default(uuid())
  userId           String?
  signalId         String
  symbol           String
  timeframe        String
  action           String   // BUY, SELL
  strategyVersion  String
  modelVersion     String
  riskStatus       String   // PASS, FAIL
  portfolioStatus  String   // PASS, FAIL
  executionStatus  String   // APPROVED, REJECTED
  idempotencyKey   String   @unique
  reasons          String[]
  warnings         String[]
  riskSnapshot     Json
  approvedAt       DateTime @default(now())
}

model ExecutionOrder {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  orderId         String   @unique @default(uuid())
  symbol          String
  side            String   // BUY, SELL
  type            String   @default("MARKET") // MARKET, LIMIT
  requestedPrice  Float
  executedPrice   Float?
  quantity        Float
  filledQuantity  Float    @default(0.0)
  status          String   // CREATED, VALIDATING, APPROVED, SUBMITTED, PARTIALLY_FILLED, FILLED, CANCEL_REQUESTED, CANCELLED, REJECTED, FAILED
  fees            Float    @default(0.0)
  slippage        Float    @default(0.0)
  strategyVersion String
  modelVersion    String
  signalId        String?
  stopLoss        Float
  takeProfit      Float
  idempotencyKey  String   @unique
  reconciledAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SafetyEvent {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  eventType   String   // CIRCUIT_BREAKER_TRIGGERED, EMERGENCY_STOP, DAILY_LOSS_EXCEEDED, RECONCILIATION_MISMATCH, SLIPPAGE_EXCEEDED, STALE_DATA_REJECTION, DUPLICATE_ORDER_BLOCKED
  severity    String   // INFO, WARNING, CRITICAL
  details     String
  metadata    Json?
  createdAt   DateTime @default(now())
}

model DailyRiskState {
  id                    String   @id @default(uuid())
  userId                String
  date                  String   // YYYY-MM-DD
  startingBalance       Float
  realizedPnL           Float    @default(0.0)
  unrealizedPnL         Float    @default(0.0)
  totalTrades           Int      @default(0)
  winningTrades         Int      @default(0)
  losingTrades          Int      @default(0)
  dailyLossLimitReached Boolean  @default(false)
  isPaused              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, date])
}

model PaymentIntent {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  sender          String
  recipient       String
  amount          Float
  currency        String   @default("USD")
  paymentMode     String   @default("WALLET_TRANSFER")
  idempotencyKey  String   @unique
  status          String   @default("CREATED") // CREATED, VALIDATING, QUEUED, PROCESSING, BROADCASTING, BROADCAST_UNKNOWN, PENDING_CONFIRMATION, CONFIRMED, FAILED, RETRY_PENDING, RECONCILING, RECOVERED, EXPIRED, MANUAL_REVIEW
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  executions      PaymentExecution[]
  events          PaymentEvent[]
  auditRecord     PaymentAuditRecord?
}

model PaymentExecution {
  id              String   @id @default(uuid())
  paymentIntentId String
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  attemptNumber   Int      @default(1)
  provider        String?
  node            String?
  transactionHash String?
  nonce           Int?
  status          String   // SUBMITTED, CONFIRMED, FAILED, TIMEOUT, UNKNOWN
  error           String?
  latencyMs       Int?
  submittedAt     DateTime @default(now())
  responseAt      DateTime?
}

model PaymentEvent {
  id                String   @id @default(uuid())
  paymentIntentId   String
  paymentIntent     PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  oldState          String?
  newState          String
  reason            String?
  actor             String?
  systemComponent   String?
  metadata          Json?
  previousEventHash String?
  eventHash         String?
  createdAt         DateTime @default(now())
}

model PaymentReconciliation {
  id              String   @id @default(uuid())
  paymentIntentId String   @unique
  status          String   // MATCHED, PARTIAL_MATCH, NO_MATCH, CONFLICT, REVIEW_REQUIRED, RESOLVED
  matchConfidence Float?
  evidence        Json?
  resolution      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PaymentFailure {
  id              String   @id @default(uuid())
  paymentIntentId String
  executionId     String?
  failureType     String   // NETWORK_TIMEOUT, RPC_TIMEOUT, NODE_UNHEALTHY, INSUFFICIENT_BALANCE, INSUFFICIENT_GAS, INVALID_TRANSACTION, NONCE_CONFLICT, CONTRACT_REVERT, UNKNOWN
  isRetryable     Boolean
  severity        String   // LOW, MEDIUM, HIGH, CRITICAL
  aiClassification String?
  aiConfidence    Float?
  metadata        Json?
  createdAt       DateTime @default(now())
}

model PredictiveModelVersion {
  id              String   @id @default(uuid())
  modelName       String
  version         String   @unique
  isActive        Boolean  @default(true)
  evaluationMetrics Json?
  createdAt       DateTime @default(now())
}

model NodeTelemetry {
  id              String   @id @default(uuid())
  provider        String
  nodeId          String
  rpcLatencyMs    Int
  errorRate       Float
  successRate     Float?
  blockTimeMs     Int?
  timestamp       DateTime @default(now())
}

model PredictiveIncident {
  id              String   @id @default(uuid())
  incidentType    String   // ANOMALY, EARLY_WARNING, CAPACITY_WARNING
  severity        String   // LOW, MEDIUM, HIGH, CRITICAL
  description     String
  provider        String?
  nodeId          String?
  confidence      Float
  evidence        Json
  recommendedAction String?
  policyDecision  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?
}

model WhatIfSimulation {
  id              String   @id @default(uuid())
  scenario        String
  parameters      Json
  predictedImpact Json
  createdAt       DateTime @default(now())
}

model ProviderReliabilityForecast {
  id              String   @id @default(uuid())
  provider        String
  reliabilityScore Float   // 0-100
  riskLevel       String   // LOW, MEDIUM, HIGH
  forecastWindow  String   // 15m, 1h, 6h
  confidence      Float
  createdAt       DateTime @default(now())
}

model PaymentAuditRecord {
  id                String   @id @default(uuid())
  paymentIntentId   String   @unique
  paymentIntent     PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  sequenceNumber    Int      @unique @default(autoincrement())
  canonicalHash     String
  previousAuditHash String
  currentAuditHash  String
  merkleBatchId     String?
  checkpointId      String?
  verificationStatus String   @default("VERIFIED") // VERIFIED, PENDING_VERIFICATION, SUSPECTED_TAMPERING, RECOVERED_AND_VERIFIED
  isRecovered       Boolean  @default(false)
  createdAt         DateTime @default(now())
  verifiedAt        DateTime?
}

model IntegrityCheckpoint {
  id                   String   @id @default(uuid())
  checkpointId         String   @unique
  lastSequenceNumber   Int
  rootHash             String
  previousCheckpointId String?
  anchorReference      String?  
  createdAt            DateTime @default(now())
  verificationStatus   String   @default("VERIFIED")
}

model BlockchainAnchor {
  id               String   @id @default(uuid())
  checkpointId     String   @unique
  rootHash         String
  transactionHash  String
  blockNumber      Int
  network          String
  createdAt        DateTime @default(now())
  verificationStatus String @default("VERIFIED")
}

model IntegrityIncident {
  id                 String   @id @default(uuid())
  incidentId         String   @unique
  type               String
  severity           String
  affectedNode       String?
  affectedBlockRange String?
  affectedPayments   String[]
  evidence           Json
  status             String   @default("DETECTED")
  aiExplanation      String?
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?
}

model RecoveryEvent {
  id             String   @id @default(uuid())
  recoveryId     String   @unique
  type           String
  affectedCount  Int
  source         String
  target         String
  evidence       Json
  status         String
  completedAt    DateTime?
  createdAt      DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════
// Task 10 — Privacy-Preserving Payment Intelligence
// ═══════════════════════════════════════════════════════════

enum DataClassification {
  PUBLIC
  INTERNAL
  SENSITIVE
  HIGHLY_SENSITIVE
}

model DataAccessEvent {
  id                 String   @id @default(uuid())
  actorId            String
  actorRole          String   // USER, ADMIN, SUPPORT, SECURITY_ADMIN, SYSTEM
  resourceType       String   // PAYMENT_RECORD, USER_PROFILE, WALLET_DATA, AI_PROMPT, AUDIT_RECORD
  resourceId         String?
  action             String   // READ, WRITE, EXPORT, DELETE, AI_QUERY
  authorizationResult String  // AUTHORIZED, DENIED, ELEVATED
  dataClassification DataClassification @default(INTERNAL)
  reason             String?
  ipAddress          String?
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, createdAt])
}

model PrivacyIncident {
  id                 String   @id @default(uuid())
  incidentType       String   // UNAUTHORIZED_ACCESS, SECRET_LEAK_ATTEMPT, CROSS_USER_ACCESS, EXCESSIVE_EXPORT, PROMPT_INJECTION, ABNORMAL_DATA_ACCESS
  severity           String   // LOW, MEDIUM, HIGH, CRITICAL
  actorId            String?
  description        String
  evidence           Json
  status             String   @default("DETECTED") // DETECTED, INVESTIGATING, RESOLVED, FALSE_POSITIVE
  resolution         String?
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?

  @@index([incidentType, createdAt])
}

model PolicyDefinition {
  id          String   @id @default(uuid())
  policyId    String
  version     String
  rules       Json     // Structured rules: thresholds, conditions, actions
  status      String   @default("ACTIVE") // ACTIVE, DRAFT, DEPRECATED
  createdBy   String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decisions   PolicyDecision[]

  @@unique([policyId, version])
}

model PolicyDecision {
  id                 String   @id @default(uuid())
  paymentIntentId    String?
  policyDefinitionId String
  policyDefinition   PolicyDefinition @relation(fields: [policyDefinitionId], references: [id])
  decision           String   // ALLOW, ALLOW_WITH_MONITORING, REQUIRE_VERIFICATION, REVIEW, BLOCK
  paymentRisk        String?  // LOW, MEDIUM, HIGH, CRITICAL
  infrastructureRisk String?
  fraudRisk          String?
  accountRisk        String?
  reasons            Json     // Array of { code, field, severity, message }
  modelVersion       String?
  evidenceRef        String?  // Links to ComplianceProof or PaymentAuditRecord
  isSimulation       Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([paymentIntentId])
  @@index([decision, createdAt])
}

model AIDataAccessRecord {
  id                 String   @id @default(uuid())
  model              String   // gemini-1.5-flash, etc
  modelVersion       String?
  purpose            String   // INCIDENT_EXPLANATION, RISK_ANALYSIS, TRADING_ADVICE, ROOT_CAUSE_ANALYSIS
  dataClassification DataClassification
  sanitizedInputHash String   // SHA-256 of the sanitized prompt (never the raw prompt)
  resultType         String   // SUCCESS, BLOCKED, ERROR
  tokenCount         Int?
  userId             String?  // Which user's context was involved (tokenized)
  blockReason        String?  // If blocked: SECRET_DETECTED, INJECTION_DETECTED, etc
  createdAt          DateTime @default(now())

  @@index([purpose, createdAt])
}

model ComplianceProof {
  id                 String   @id @default(uuid())
  paymentIntentId    String
  proofType          String   // PAYMENT_COMMITTED, AMOUNT_UNMODIFIED, POLICY_PASSED, HISTORY_INTACT
  policyVersion      String?
  auditRecordHash    String?  // Links to PaymentAuditRecord.currentAuditHash
  checkpointHash     String?  // Links to IntegrityCheckpoint.rootHash
  anchorTxHash       String?  // Links to BlockchainAnchor.transactionHash
  claimData          Json     // { claim, evidence, verificationMethod }
  isValid            Boolean  @default(true)
  verifiedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([paymentIntentId])
}
