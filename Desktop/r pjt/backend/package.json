{
  "name": "vehicle-passport-backend",
  "version": "1.0.0",
  "description": "Backend API for Blockchain Vehicle Passport",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && mkdir -p dist/src/blockchain/contracts && cp src/blockchain/contracts/*.json dist/src/blockchain/contracts/",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "seed:demo": "ts-node prisma/seed_demo.ts",
    "verify:demo": "ts-node scripts/verify_demo_dataset.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
